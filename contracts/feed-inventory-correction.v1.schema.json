{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tamago:feed-inventory-correction:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema_version",
        "revision_id",
        "company_id",
        "target_kind",
        "target_id",
        "expected_revision",
        "previous_revision_id",
        "reason",
        "product_id",
        "location_id"
      ],
      "properties": {
        "format": {
          "const": "tamago.feed-inventory-correction"
        },
        "schema_version": {
          "const": 1
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "company_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "target_kind": {
          "const": "binding"
        },
        "target_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "previous_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "product_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "location_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_revision": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "previous_revision_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous_revision_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema_version",
        "revision_id",
        "company_id",
        "target_kind",
        "target_id",
        "expected_revision",
        "previous_revision_id",
        "reason",
        "classification",
        "expected_opening_binding_revision",
        "expected_movement_binding_revision"
      ],
      "properties": {
        "format": {
          "const": "tamago.feed-inventory-correction"
        },
        "schema_version": {
          "const": 1
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "company_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "target_kind": {
          "const": "cutoff"
        },
        "target_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "previous_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "classification": {
          "enum": ["included_in_count", "after_count"]
        },
        "expected_opening_binding_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "expected_movement_binding_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_revision": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "previous_revision_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previous_revision_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
    }
  ]
}
