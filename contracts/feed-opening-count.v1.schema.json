{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tamago:feed-opening-count:v1",
  "title": "Immutable physical opening count, not applied to inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_id",
    "site_id",
    "house_id",
    "lot_id",
    "schema_version",
    "business_date",
    "product_declared",
    "quantity",
    "unit",
    "notes",
    "cutoff_at",
    "format",
    "opening_id",
    "count_id",
    "expected_revision",
    "previous_count_id",
    "location_declared",
    "evidence_reference"
  ],
  "properties": {
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "house_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "lot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {
      "const": 1
    },
    "business_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "product_declared": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "unit": {
      "const": "BAG_40KG"
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "cutoff_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "format": {
      "const": "tamago.feed-opening-count"
    },
    "opening_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "count_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "previous_count_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "location_declared": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "evidence_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
