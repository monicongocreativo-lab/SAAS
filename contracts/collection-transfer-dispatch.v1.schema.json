{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamago.invalid/contracts/collection-transfer-dispatch.v1.schema.json",
  "title": "Experimental physical collection transfer dispatch v1",
  "description": "Calendar dates and canonical timestamp are additionally checked by transfer-contract.mjs and Postgres. Authenticated sender is derived by server, never supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transfer_id",
    "company_id",
    "site_id",
    "house_id",
    "lot_id",
    "origin_business_date",
    "quantity_sent",
    "sent_from",
    "sent_to",
    "sent_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "transfer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "house_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "lot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origin_business_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "quantity_sent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sent_from": {
      "type": "string",
      "maxLength": 160,
      "pattern": "\\S"
    },
    "sent_to": {
      "type": "string",
      "maxLength": 160,
      "pattern": "\\S"
    },
    "sent_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
