{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamago.invalid/contracts/manual-classification-receipt.v1.schema.json",
  "title": "Acuse de registro manual de clasificación v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "tamago.manual-classification-receipt"
    },
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origin_business_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "processed_quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 107374182350
    },
    "recorded_by": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "review_status": {
      "const": "pending"
    },
    "configuration_status": {
      "const": "declared_unverified"
    },
    "duplicate": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "schema_version",
    "session_id",
    "company_id",
    "origin_business_date",
    "processed_quantity",
    "recorded_by",
    "recorded_at",
    "review_status",
    "configuration_status",
    "duplicate"
  ]
}
