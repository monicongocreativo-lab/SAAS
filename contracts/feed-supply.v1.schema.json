{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tamago:feed-supply:v1",
  "title": "Declared supply of confirmed 40 kg bags, not biological intake or stock approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "company_id",
    "site_id",
    "house_id",
    "lot_id",
    "schema_version",
    "business_date",
    "occurred_at",
    "product_declared",
    "quantity",
    "unit",
    "source_declared",
    "physical_batch_declared",
    "notes"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "house_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "lot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "schema_version": {
      "const": 1
    },
    "business_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "product_declared": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "unit": {
      "const": "BAG_40KG"
    },
    "source_declared": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "physical_batch_declared": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 2000
    }
  }
}
