{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tamago:feed-inventory-cutoff:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "action_id",
    "company_id",
    "opening_id",
    "count_id",
    "source_id",
    "source_kind",
    "classification",
    "reason"
  ],
  "properties": {
    "format": {
      "const": "tamago.feed-cutoff-decision"
    },
    "schema_version": {
      "const": 1
    },
    "action_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "opening_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "count_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_kind": {
      "enum": ["supply", "delivery"]
    },
    "classification": {
      "enum": ["included_in_count", "after_count"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "expected_opening_binding_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999999
    },
    "expected_movement_binding_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999999
    }
  },
  "dependentRequired": {
    "expected_opening_binding_revision": ["expected_movement_binding_revision"],
    "expected_movement_binding_revision": ["expected_opening_binding_revision"]
  }
}
