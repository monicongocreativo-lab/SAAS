{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamago.invalid/contracts/origin-flow-summary.v1.schema.json",
  "title": "Consulta del recorrido por origen v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "tamago.origin-flow-summary"
    },
    "schema_version": {
      "const": 1
    },
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origin_business_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "as_of": {
      "type": "string"
    },
    "purpose": {
      "const": "consultation_only"
    },
    "items": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "site_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "house_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "lot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "lot_code": {
            "type": "string"
          },
          "lot_status": {
            "type": "string"
          },
          "house_name": {
            "type": "string"
          },
          "site_name": {
            "type": "string"
          },
          "origin_business_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "collection_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transfer_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "receipt_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "open_incidents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity_sent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity_in_transit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity_received": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity_classified": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "custody_shortage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "custody_surplus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity_destination_undefined": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity_discard_declared": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity_pending_classification": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "custody_difference": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "quantity_collected": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity_at_house": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "company_id",
          "site_id",
          "house_id",
          "lot_id",
          "lot_code",
          "lot_status",
          "house_name",
          "site_name",
          "origin_business_date",
          "collection_count",
          "transfer_count",
          "receipt_count",
          "open_incidents",
          "quantity_sent",
          "quantity_in_transit",
          "quantity_received",
          "quantity_classified",
          "custody_shortage",
          "custody_surplus",
          "quantity_destination_undefined",
          "quantity_discard_declared",
          "quantity_pending_classification",
          "custody_difference",
          "quantity_collected",
          "quantity_at_house"
        ]
      }
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100025
        }
      ]
    }
  },
  "required": [
    "format",
    "schema_version",
    "company_id",
    "origin_business_date",
    "as_of",
    "purpose",
    "items",
    "next_offset"
  ]
}
