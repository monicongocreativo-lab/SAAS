{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tamago:feed-inventory-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "event",
    "actor_id",
    "recorded_at",
    "inventory_check",
    "duplicate"
  ],
  "properties": {
    "format": {
      "const": "tamago.feed-inventory-command-receipt"
    },
    "schema_version": {
      "const": 1
    },
    "event": {
      "oneOf": [
        {
          "$ref": "urn:tamago:feed-inventory-catalog:v1"
        },
        {
          "$ref": "urn:tamago:feed-inventory-binding:v1"
        },
        {
          "$ref": "urn:tamago:feed-inventory-cutoff:v1"
        }
      ]
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "inventory_check": {
      "const": "not_applied"
    },
    "duplicate": {
      "type": "boolean"
    }
  }
}
