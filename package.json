{
  "name": "tamago-operational-prototype",
  "version": "0.2.0-experimental",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build-offline.mjs",
    "start": "node scripts/serve.mjs",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:browser": "pnpm build && node --test tests/browser/*.test.mjs",
    "lint": "biome check src/offline scripts tests/offline-contract.test.mjs tests/browser/offline.test.mjs tests/fixtures/offline-harness.mjs contracts package.json biome.json",
    "check": "pnpm build && pnpm lint && pnpm test && pnpm test:browser"
  },
  "dependencies": {
    "idb": "8.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
