{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamago.invalid/contracts/custody-case-command.v1.schema.json",
  "title": "Experimental custody review command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "company_id",
    "incident_id",
    "expected_revision",
    "action",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "action": {
      "type": "string"
    },
    "details": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "action": {
          "const": "add_evidence"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "notes"],
          "properties": {
            "kind": {
              "enum": [
                "sender_statement",
                "origin_card",
                "count_record",
                "transfer_note",
                "photo_reference",
                "other",
                "missing"
              ]
            },
            "reference": {
              "type": ["string", "null"],
              "maxLength": 500
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "[^ ]"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "submit"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "[^ ]"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "request_evidence"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "[^ ]"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "continue_investigation"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "[^ ]"
            }
          }
        }
      }
    }
  ]
}
