{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamago.invalid/contracts/manual-classification.v1.schema.json",
  "title": "Manual classification of received eggs v1",
  "description": "Calendar/Colombia chronology, duplicate IDs and conservation are additionally validated by native validator and Postgres. This vocabulary is not an approved machine weight configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "company_id",
    "site_id",
    "house_id",
    "lot_id",
    "origin_business_date",
    "classified_at",
    "machine_configuration_reference",
    "notes",
    "inputs",
    "lines"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "house_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "lot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origin_business_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "classified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "machine_configuration_reference": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transfer_id", "quantity_eggs"],
        "properties": {
          "transfer_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "quantity_eggs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "quantity_eggs",
          "typology",
          "condition",
          "destination"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "quantity_eggs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "typology": {
            "enum": ["PIPO", "C", "B", "A", "AA", "AAA", "YUMBO", "UNKNOWN"]
          },
          "condition": {
            "enum": ["NORMAL", "DIRTY", "BROKEN", "YOLK"]
          },
          "destination": {
            "enum": ["PENDING", "DISCARD"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "typology": {
                  "const": "PIPO"
                }
              }
            },
            "then": {
              "properties": {
                "destination": {
                  "const": "DISCARD"
                }
              }
            }
          }
        ]
      }
    }
  }
}
